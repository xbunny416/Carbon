{
	"name": "CarOff",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Assets": {
				"$path": "assets/generated/Assets.rbxmx"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"TextChatService": {
			"$properties": {
				"ChatVersion": "TextChatService"
			}
		},
		"Lighting": {
			"$properties": {
				"LightingStyle": "Realistic",
				"GlobalShadows": true,
				"ClockTime": 14.5,
				"GeographicLatitude": 35,
				"Brightness": 2.5,
				"OutdoorAmbient": [0.56, 0.53, 0.49],
				"EnvironmentDiffuseScale": 1,
				"EnvironmentSpecularScale": 1
			},
			"Atmosphere": {
				"$className": "Atmosphere",
				"$properties": {
					"Density": 0.32,
					"Offset": 0.15,
					"Color": [0.78, 0.84, 0.9],
					"Decay": [0.62, 0.68, 0.74],
					"Glare": 0.1,
					"Haze": 1.8
				}
			},
			"ColorCorrection": {
				"$className": "ColorCorrectionEffect",
				"$properties": {
					"Contrast": 0.03,
					"Saturation": -0.05,
					"TintColor": [1, 0.99, 0.96]
				}
			},
			"SunRays": {
				"$className": "SunRaysEffect",
				"$properties": {
					"Intensity": 0.03,
					"Spread": 0.6
				}
			}
		},
		"LocalizationService": {
			"GameStrings": {
				"$path": "src/localization/GameStrings.csv"
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": true,
				"StreamingMinRadius": 256,
				"StreamingTargetRadius": 1024
			},
			"Desert": {
				"$path": "maps/generated/Desert.rbxmx"
			}
		}
	}
}
