--!strict
--[[
	ReplicatedStorage.Assets: the templates game code clones instead of building effects, sounds, animations and
	models from scratch (owner's rule). Generated by `lune run assets/build` from Config, like the maps.
	  VFX        — particle / beam / trail templates (add builders here; never an emitter with the default texture)
	  Sounds     — one Sound per Config.Audio slot with an id (Music/<name>, Sfx/<name>)
	  Animations — one Animation per Config.Animations.AssetIds entry
	  Models     — props, weapons, accessories (add builders here); Models/Cars: one drivable car per Config.Cars.Models
	               entry, built by assets/cars/<Name>.luau
]]
local Shim = require("../tests/roblox")
local roblox = require("@lune/roblox")

-- Car builders by Config.Cars.Models name (assets/cars).
local CAR_BUILDERS: { [string]: any } = {
	RustyPickup = require("./cars/RustyPickup"),
}

local Assets = {}

local function folder(name: string, parent: any?): any
	local f = roblox.Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function sounds(config: any, parent: any)
	local root = folder("Sounds", parent)
	for _, group in { "Music", "Sfx" } do
		local groupFolder = folder(group, root)
		local slots = config.Audio[group]
		local names = {}
		for name in slots do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in names do
			local slot = slots[name]
			if slot.Id ~= 0 then
				local sound = roblox.Instance.new("Sound")
				sound.Name = name
				sound.SoundId = `rbxassetid://{slot.Id}`
				sound.Volume = slot.Volume
				sound.Looped = group == "Music"
				sound.Parent = groupFolder
			end
		end
	end
end

local function animations(config: any, parent: any)
	local root = folder("Animations", parent)
	local names = {}
	for name in config.Animations.AssetIds do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in names do
		local id = config.Animations.AssetIds[name]
		if id ~= 0 then
			local animation = roblox.Instance.new("Animation")
			animation.Name = name
			animation.AnimationId = `rbxassetid://{id}`
			animation.Parent = root
		end
	end
end

local function cars(config: any, parent: any)
	local root = folder("Cars", parent)
	local names = {}
	for name in config.Cars.Models do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in names do
		local builder = assert(CAR_BUILDERS[name], `no car builder for Config.Cars.Models.{name} (assets/cars)`)
		builder.build(config.Controls.Prompts).Parent = root
	end
end

-- Builds the Assets folder.
function Assets.build(): any
	local Config = Shim.require(Shim.game.ReplicatedStorage.Shared.Config)
	local root = folder("Assets")
	folder("VFX", root)
	sounds(Config, root)
	animations(Config, root)
	cars(Config, folder("Models", root))
	return root
end

return Assets
